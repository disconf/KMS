# KMS 生产部署环境变量（复制为 .env 后由 bootstrap.sh 填充密钥）
# .env 含真实口令，已被 .gitignore 排除，严禁提交。

# 部署版本号（打进二进制与镜像 tag）
KMS_VERSION=1.0.0

# 站点域名（nginx 与应用配置都用它）
APP_DOMAIN=www.jinzhiqiang.com

# MySQL。root 口令仅容器内部运维用；应用账号 kms 由初始化脚本创建
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kms
MYSQL_APP_PASSWORD=

# 应用密钥（openssl rand -hex 32 生成）
JWT_SECRET=
SIGN_SECRET=

# 首次初始化时的管理员（13800000000）登录密码。
# 留空则沿用开发默认口令 Admin@12345——仅限本地，生产必须设置！
SEED_ADMIN_PASSWORD=
