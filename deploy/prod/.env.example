# KMS 生产部署环境变量（复制为 .env 后由 bootstrap.sh 填充密钥）
# .env 含真实口令，已被 .gitignore 排除，严禁提交。

# 部署版本号（打进二进制与镜像 tag）
KMS_VERSION=1.0.0

# 站点域名（nginx 与应用配置都用它）
APP_DOMAIN=www.jinzhiqiang.com

# MySQL。root 口令仅容器内部运维用；应用账号 kms 由初始化脚本创建
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kms
MYSQL_APP_PASSWORD=

# 应用密钥（openssl rand -hex 32 生成）
JWT_SECRET=
SIGN_SECRET=

# 首次初始化时的管理员（13800000000）登录密码。
# 留空则沿用开发默认口令 Admin@12345——仅限本地，生产必须设置！
SEED_ADMIN_PASSWORD=

# 邮箱验证码通道。用户注册与邮箱登录都走这里，不填则注册直接返回 501。
# 生产禁止 MAIL_PROVIDER=mock（启动时校验会拒），也禁止 MAIL_EXPOSE_CODE=true。
#
# QQ 邮箱 / 163 / 腾讯企业邮 / 阿里云邮 都按下面的填法：
#   MAIL_SMTP_HOST=smtp.qq.com      MAIL_SMTP_PORT=465      MAIL_SMTP_TLS=true
#   MAIL_SMTP_USERNAME=you@qq.com   MAIL_SMTP_PASSWORD=授权码（不是登录密码）
#   MAIL_SMTP_FROM=you@qq.com       MAIL_SMTP_FROM_NAME=个人工作经验分享
# 端口 465 走隐式 TLS，587/25 走 STARTTLS，两种都支持。
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM=
MAIL_SMTP_FROM_NAME=个人工作经验分享
MAIL_SMTP_TLS=true
# 验证码有效期、同一邮箱的最小发送间隔、每小时/每天上限
MAIL_CODE_TTL=10m
MAIL_SEND_INTERVAL=60s
MAIL_HOURLY_LIMIT=5
MAIL_DAILY_LIMIT=20
