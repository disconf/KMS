# 构建产物
bin/
*.exe

# 本地数据（SQLite）。必须锚定到 server/ 根：
# 写成 data/ 会连 internal/bootstrap/data/（go:embed 的 96 篇教程正文）一起忽略，
# 那些文件进不了仓库，Docker 构建时 go:embed 直接 no matching files found。
/data/
*.db
*.db-shm
*.db-wal

# 本地配置与凭据：绝不入库
.env
configs/config.yaml

# 测试产物
coverage.out
*.test

# 编辑器
.idea/
.vscode/
.DS_Store

# 两连冒烟的临时工作目录
.smoke-run/

# 交叉编译产物（部署用，不入库）
dist/

# 部署自检/冒烟的临时目录
.sched-run/
.render-run/

# 本地开发服务的库与日志（run_in_background 起服务时用）
.dev-run/
.dbg/
