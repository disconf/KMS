# 环境变量覆盖示例：复制为 .env 放在 server/ 目录下即可自动加载
# 环境变量优先级高于 configs/config.yaml

APP_ENV=dev
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

LOG_LEVEL=debug
LOG_FORMAT=text

# ---- 零依赖本地开发（默认） ----
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/ops_expert.db
REDIS_ADDR=

# ---- 切换 MySQL + Redis（生产/联调） ----
# DB_DRIVER=mysql
# DB_DSN=root:root@tcp(127.0.0.1:3306)/ops_expert?charset=utf8mb4&parseTime=True&loc=Local
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=

JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

SMS_PROVIDER=mock
SMS_EXPOSE_CODE=true

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK=true

# ---- 支付与结算 ----
# mock 仅限本地：它会把订单直接置为已支付。生产启动时会被硬拦。
PAYMENT_PROVIDER=mock
PAYMENT_PAY_TIMEOUT=15m
PAYMENT_AUTO_CONFIRM_AFTER=48h
PAYMENT_COMMISSION_RATE_BP=1500
PAYMENT_NOTIFY_URL=
